{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BoundaryMaximumPermissions",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey",
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": [
        "${table_arn}",
        "${table_arn}/index/*",
        "${log_group_arn}:*",
        "${kms_key_arn}",
        "arn:${partition}:xray:${region}:${account_id}:*"
      ]
    },
    {
      "Sid": "BoundaryAllowMembershipReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "${membership_table_arn}"
    },
    {
      "Sid": "BoundaryDenyMembershipWrites",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": [
        "${membership_table_arn}",
        "${membership_table_arn}/*"
      ]
    },
    {
      "Sid": "BoundaryDenyEverythingOfConsequence",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminSetUserPassword",
        "cognito-idp:AdminUpdateUserAttributes",
        "dynamodb:DeleteItem",
        "dynamodb:DeleteTable",
        "dynamodb:Scan",
        "dynamodb:UpdateItem",
        "ec2:CreateNetworkInterface",
        "ec2:RunInstances",
        "iam:AttachRolePolicy",
        "iam:CreateAccessKey",
        "iam:CreatePolicy",
        "iam:CreateRole",
        "iam:CreateUser",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "lambda:AddPermission",
        "lambda:InvokeFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "s3:GetObject",
        "s3:PutObject",
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "sts:AssumeRole",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    }
  ]
}
